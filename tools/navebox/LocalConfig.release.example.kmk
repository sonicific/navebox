#
# Copy to LocalConfig.release.kmk, then configure your SDKs and signing inputs.
# Keep private paths, credentials and compiler workarounds in that local file.
# The helper supplies tool paths from navebox-build.local.json.
#
VBOX_OSE := 1
VBOX_WITH_INSTALLER := 1
VBOX_WITH_QT_PAYLOAD := 1
VBOX_WITHOUT_ADDITIONS := 1
VBOX_WITHOUT_DOCS := 1
VBOX_WITH_ADDITIONS_PACKING :=
VBOX_WITH_DOCS :=
VBOX_WITH_DOCS_PACKING :=
VBOX_WITH_DOCS_QHELP_PACKING :=
VBOX_WITH_PYTHON :=
VBOX_WITH_JAVA :=
VBOX_WITH_WEBSERVICES :=
VBOX_WITH_JWS :=
VBOX_WITH_TESTCASES :=
VBOX_INSTALLER_LANGUAGES := en_US
VBOX_INSTALLER_MERGE_LANGUAGES := en_US

# Use the verified BIOS assembly when the external toolchain has no Watcom.
VBOX_WITH_OPEN_WATCOM :=

# Public Qt headers use their own warning policy.
VBOX_LOCAL_QT_CXXFLAGS := -external:I$(VBOX_PATH_QT)/include -external:W0
VirtualBox_CXXFLAGS.win += $(VBOX_LOCAL_QT_CXXFLAGS)
VirtualBoxVM_CXXFLAGS.win += $(VBOX_LOCAL_QT_CXXFLAGS)
UICommon_CXXFLAGS.win += $(VBOX_LOCAL_QT_CXXFLAGS)
VBoxDbg_CXXFLAGS.win += $(VBOX_LOCAL_QT_CXXFLAGS)

# Configure VBOX_SIGNING_MODE and the signing inputs for your environment here.
# Do not disable hardening or force driverless execution for the conventional
# driver-backed package. Production driver trust requires separate qualification.
